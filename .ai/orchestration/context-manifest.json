{
  "version": "3.0",
  "description": "Context routing manifest — maps task types and domains to canonical Antigravity skills and rules",
  "contextGroups": {
    "core": {
      "description": "Always loaded for any task",
      "files": [
        ".ai/settings.json",
        ".ai/state/project.json"
      ]
    },
    "backend": {
      "description": "Backend development context",
      "files": [
        ".agents/skills/implementing-backend/SKILL.md",
        ".agents/rules/coding-rules.md",
        ".agents/rules/architecture-rules.md"
      ]
    },
    "frontend": {
      "description": "Frontend development context",
      "files": [
        ".agents/skills/implementing-frontend/SKILL.md",
        ".agents/rules/ui-guidelines.md",
        ".agents/rules/coding-rules.md"
      ]
    },
    "database": {
      "description": "Database operations context",
      "files": [
        ".agents/skills/designing-database/SKILL.md",
        ".agents/rules/architecture-rules.md"
      ]
    },
    "security": {
      "description": "Security-sensitive changes",
      "files": [
        ".agents/skills/securing-applications/SKILL.md",
        ".agents/rules/security.md",
        ".agents/rules/coding-rules.md"
      ]
    },
    "testing": {
      "description": "Test writing and execution",
      "files": [
        ".agents/skills/testing-software/SKILL.md",
        ".agents/rules/coding-rules.md"
      ]
    },
    "deployment": {
      "description": "Deployment and infrastructure",
      "files": [
        ".agents/skills/deploying-software/SKILL.md",
        ".agents/rules/tech-stack.md"
      ]
    },
    "planning": {
      "description": "Planning and architecture design",
      "files": [
        ".agents/skills/planning/SKILL.md",
        ".agents/skills/analyzing-prd/SKILL.md",
        ".agents/skills/designing-architecture/SKILL.md",
        ".agents/rules/architecture-rules.md",
        ".agents/rules/tech-stack.md",
        "doc/prd.md"
      ]
    },
    "bug-fix": {
      "description": "Bug investigation and fix",
      "files": [
        ".agents/skills/debugging-software/SKILL.md",
        ".agents/skills/testing-software/SKILL.md",
        ".agents/rules/coding-rules.md"
      ]
    },
    "review": {
      "description": "Code review and verification",
      "files": [
        ".agents/skills/reviewing-code/SKILL.md",
        ".agents/skills/verifying-changes/SKILL.md",
        ".agents/rules/coding-rules.md",
        ".agents/rules/architecture-rules.md"
      ]
    },
    "evaluation": {
      "description": "Outcome evaluation and independent grading",
      "files": [
        ".agents/skills/evaluating-results/SKILL.md",
        ".agents/skills/verifying-changes/SKILL.md"
      ]
    },
    "state": {
      "description": "Task and project state (loaded when resuming or tracking)",
      "files": [
        ".ai/state/tasks.json",
        ".ai/state/blockers.json",
        ".ai/state/decisions.json"
      ]
    }
  },
  "taskTypeToContextGroups": {
    "simple-fix": ["core", "backend"],
    "bug-fix": ["core", "bug-fix", "state"],
    "feature": ["core", "planning", "backend", "testing"],
    "complex-feature": ["core", "planning", "backend", "frontend", "database", "security", "testing"],
    "deployment": ["core", "deployment"],
    "refactor": ["core", "backend", "testing", "review"],
    "planning": ["core", "planning"],
    "security-change": ["core", "security", "backend", "testing", "review"],
    "database-change": ["core", "database", "backend", "testing"],
    "evaluation": ["core", "evaluation"]
  },
  "rules": [
    "Always load 'core' context group",
    "Load additional groups based on multidimensional task classification",
    "When task affects both backend and frontend, load both groups",
    "When task involves auth/security, always load security group",
    "When resuming, always load state group",
    "Never load all groups simultaneously unless explicitly needed"
  ]
}
