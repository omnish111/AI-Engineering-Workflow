{
  "version": "3.0.0",
  "architectureVersion": "v3-antigravity",
  "project": {
    "name": "AI Engineering Workflow",
    "description": "Antigravity-first, Skills-first AI engineering harness for PRD-to-software execution",
    "status": "active"
  },
  "orchestration": {
    "model": "capability-tier",
    "skillRegistry": "orchestration/skill-registry.json",
    "roleRegistry": "orchestration/role-registry.json",
    "modelRouting": "orchestration/model-routing.json",
    "taskClassifier": "orchestration/task-classifier.md",
    "decisionPolicy": "orchestration/decision-policy.json",
    "contextManifest": "orchestration/context-manifest.json",
    "checkpointPolicy": "orchestration/checkpoint-policy.json",
    "verificationSchema": "orchestration/verification-schema.json",
    "parallelPolicy": "orchestration/parallel-policy.md"
  },
  "workflow": {
    "model": "task-dag",
    "taskGraph": "state/tasks.json",
    "taskGraphScript": "scripts/task-graph.js"
  },
  "paths": {
    "rules": ".agents/rules",
    "skills": ".agents/skills",
    "agents": ".agents/agents",
    "hooks": ".agents/hooks.json",
    "orchestration": ".ai/orchestration",
    "state": ".ai/state",
    "evaluations": "evals/golden-tasks",
    "templates": ".ai/templates",
    "scripts": ".ai/scripts",
    "archive": ".ai/archive",
    "prd": "doc/prd.md",
    "source_backend": "codebase/backend",
    "source_frontend": "codebase/frontend"
  }
}